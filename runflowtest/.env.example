# RunFlowTest Environment Variables

# Backend (.env in backend directory)
APP_ENV=production
DB_TYPE=mysql
DB_HOST=localhost
DB_USER=runflowtest
DB_PASS=secure_password
DB_NAME=runflowtest

# Email Configuration
MAIL_DRIVER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USER=your-email@gmail.com
MAIL_PASS=your-app-password
MAIL_FROM=noreply@runflowtest.com

# API Configuration
API_URL=https://runflowtest.poojakudesia.in/api
FRONTEND_URL=https://runflowtest.poojakudesia.in

# Security
JWT_SECRET=generate-a-random-secret-key-here

# Frontend (.env in frontend directory)
VITE_API_URL=https://runflowtest.poojakudesia.in/api
