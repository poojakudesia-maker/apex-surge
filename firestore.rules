rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    // Public, read-only content catalog (seeded via admin script).
    match /books/{bookId} {
      allow read: if true;
      allow write: if false;
    }

    match /users/{uid} {
      allow read, update: if isOwner(uid);
      allow create: if isOwner(uid);
      allow delete: if false;

      match /missions/{missionId} {
        allow read, write: if isOwner(uid);
      }

      match /experiments/{experimentId} {
        allow read, write: if isOwner(uid);
      }

      match /journeys/{journeyId} {
        allow read, write: if isOwner(uid);
      }

      match /playbookInsights/{insightId} {
        // AI-generated via Cloud Functions (admin SDK bypasses rules); read-only from the client.
        allow read: if isOwner(uid);
        allow write: if false;
      }

      match /playbookPrinciples/{principleId} {
        allow read, write: if isOwner(uid);
      }

      match /worksForMe/{itemId} {
        allow read, write: if isOwner(uid);
      }

      match /coachThreads/{threadId} {
        allow read: if isOwner(uid);
        allow write: if false;

        match /messages/{messageId} {
          allow read: if isOwner(uid);
          allow write: if false;
        }
      }

      match /roleplays/{roleplayId} {
        allow read: if isOwner(uid);
        allow write: if false;
      }

      match /weeklyReviews/{reviewId} {
        allow read: if isOwner(uid);
        allow write: if false;
      }
    }
  }
}
